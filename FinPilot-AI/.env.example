# Copy to .env (PowerShell: Copy-Item .env.example .env) and set your own password.
# .env is git-ignored. Never commit real secrets.
# Used by Docker Compose AND by the Spring Boot backend (it imports ../.env when run from backend/).

POSTGRES_DB=finpilot
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Optional backend overrides
# DB_HOST=localhost
# SERVER_PORT=8080

# Synthetic demo data: seeds SEED_COUNT payments on backend startup (only if none were seeded before)
SEED_ENABLED=true
SEED_COUNT=500
